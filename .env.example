# ---------------------------------------------------------------
# HabitFlow environment variables
# ---------------------------------------------------------------
# 1. Copy this file to a new file named `.env.local`
#      macOS/Linux:  cp .env.example .env.local
#      Windows:      copy .env.example .env.local
# 2. Replace the placeholder values with YOUR Supabase project's values.
#    Find them in the Supabase dashboard: Project Settings → API Keys / Data API.
# 3. Restart `npm run dev` — Vite only reads env files when it starts.
#
# Only client-safe values belong here. Variables prefixed with VITE_ are
# bundled into the browser code, so NEVER put a service_role or secret key here.
# ---------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your publishable key (starts with sb_publishable_...).
# Older projects can use the legacy "anon" public key here instead.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
